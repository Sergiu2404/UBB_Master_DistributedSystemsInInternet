{
  "name": "wifi-net-analyzer-ui",
  "version": "0.0.0",
  "main": "electron-dist/electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --base-href ./",
    "test": "ng test",
    "electron:compile": "tsc -p tsconfig.electron.json",
    "electron:dev": "npm run electron:compile && concurrently -k \"ng serve\" \"wait-on http://localhost:4200 && electron .\"",
    "electron:prod": "ng build --base-href ./ && npm run electron:compile && set ELECTRON_PROD=1&& electron .",
    "dist": "ng build --base-href ./ && npm run electron:compile && electron-builder --win"
  },
  "build": {
    "appId": "ro.ubb.wifinetanalyzer",
    "productName": "WiFi Net Analyzer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-dist/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "private": true,
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "chart.js": "^4.6.1",
    "ng2-charts": "^11.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "wait-on": "^9.5.1"
  },
  "allowScripts": {
    "electron@45.3.2": true
  }
}
